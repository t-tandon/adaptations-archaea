#pick representative genome per species
#make directory
mkdir data
cd data

#get latest gtdb metadata for archaea
wget https://data.gtdb.aau.ecogenomic.org/releases/latest/ar53_metadata.tsv.gz

## Task: Pick one genome per (taxon) with highest completeness and lowest contamination. 

## find the number of relevant columns
head -n 1 ar53_metadata.tsv | tr '\t' '\n' | nl

## filter for good quality
awk -F'\t' 'NR==1 || ($3>=90 && $4<=5)' ar53_metadata.tsv > ar53_metadata.complete.c90.tsv 
  #$3 = checkm2_completeness
  #$4 = checkm2_contamination 

## add species to last column (114) 
awk -F'\t' 'BEGIN{OFS="\t"}
NR==1 {print $0, "species"
next
}
{split($20, tax, ";")
  sp = "NA"
  for (i in tax) {
    if (tax[i] ~ /^s__/) {
      sp = substr(tax[i], 4)}}
  print $0, sp}' ar53_metadata.complete.c90.tsv  > ar53_with_species.tsv

#sort by species (best genome first) 
sort -t$'\t' -k114,114 -k3,3nr -k4,4n ar53_with_species.tsv > archaea_sorted_species.tsv

#pick representative genome per species
awk -F'\t' 'NR==1 || !seen[$114]++' archaea_sorted_species.tsv > archaea_repr.tsv

# gives 3444 archaea_repr.tsv

## extract accession ids and remove prefixes 
cut -f1 archaea_repr.tsv | tail -n +2 | cut -d'_' -f2,3 > archaea_repr_acc.txt

#ensure header is removed
grep -vi '^accession$' archaea_repr_acc.txt > archaea_repr_acc.clean.txt
mv archaea_repr_acc.clean.txt archaea_repr_acc.txt

## download genomes
datasets download genome accession --inputfile archaea_repr_acc.txt --filename archaea_genomes.zip

unzip archaea_genomes.zip
#gives ncbi_dataset, move to main folder
