#create environment
conda create -n genomespot_env python=3.10 # Use a compatible Python version
conda activate genomespot_env

#clone genomespot repo and packages
git clone https://github.com/cultivarium/GenomeSPOT.git
cd GenomeSPOT
pip install .
pip install -r requirements.txt

#make folder
mkdir -p genomespot_out

#run genomespot
for faa in prokka_output/prokka_*/*.faa; do
  accession=$(basename "$faa" | grep -oE 'GC[AF]_[0-9]+\.[0-9]+')
  fna=$(find Documents/data/ncbi_dataset/data -type f -name "${accession}*_genomic.fna" | head -n 1)
  python -m genome_spot.genome_spot --models "$MODEL_DIR" --contigs "$fna" --proteins "$faa" --output "genomespot_out/${accession}"

