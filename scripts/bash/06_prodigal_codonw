### @3rd silent codon position (codonw) 

#prokka tends to output incomplete .ffn files, which do not work for codonw
#use prodigal and filter for complete sequences

#create clean environment
conda create -n prodigal_env -c bioconda -c conda-forge prodigal
conda activate prodigal_env


genomes="../data/ncbi_dataset/data/*/*.fna"

for file in $genomes; do
  #extract accession 
  acc=$(basename "$file" _genomic.fna)

  #output files
  faa="${acc}.faa"
  ffn="${acc}_cds.ffn"
  gff="${acc}_prodigal.gff"

  #run prodigal
  prodigal -i "$file" -a "$faa" -d "$ffn" -f gff -o "$gff" -g 11 -c -m
done 
  

#install codonw
conda install -c bioconda codonw

#create directory
mkdir gc3_results

#run codonw
for file in ../prodigal_out/*ffn; do 
  base=$(basename "$file" .ffn)
  codonw "$file" -all_indices -nomenu
  mv "${base}.blk" "gc3_results/${base}_gc3.blk"; 
done
